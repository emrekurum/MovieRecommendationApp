{
  "name": "MovieRecommendationApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "bash -c 'export ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\"; export ANDROID_SDK_ROOT=\"${ANDROID_SDK_ROOT:-$ANDROID_HOME}\"; export PATH=\"$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator\"; exec expo start'",
    "android": "bash -c 'export ANDROID_HOME=\"${ANDROID_HOME:-$HOME/Android/Sdk}\"; export ANDROID_SDK_ROOT=\"${ANDROID_SDK_ROOT:-$ANDROID_HOME}\"; export PATH=\"$PATH:$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator\"; exec expo start --android'",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "expo": "^51.0.0",
    "expo-constants": "~16.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "0.74.85",
    "@react-native/metro-config": "0.74.85",
    "@react-native/typescript-config": "0.74.85",
    "@types/react": "~18.2.79",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-preset-expo": "~11.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
